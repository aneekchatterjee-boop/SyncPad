# Port and interface the HTTP + WebSocket server listens on
PORT=3000
HOST=0.0.0.0

# Where rooms are persisted (rooms.json). Relative paths resolve from the repo root.
DATA_DIR=data

# Milliseconds a dropped connection keeps its seat before it is removed from the room
RECONNECT_GRACE_MS=8000

# Milliseconds a disconnected host keeps admin rights before they pass to the
# oldest active member. Long enough to survive a page refresh.
HOST_GRACE_MS=3000

# Only needed if the frontend is served from a different origin
# CORS_ORIGIN=http://localhost:5173

# Set to 1 behind a reverse proxy so client IPs come from X-Forwarded-For
# TRUST_PROXY=1
